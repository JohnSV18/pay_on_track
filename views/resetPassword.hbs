<div class="page-container">
    <div class="form-box">
        {{> flash-messages}}
        <h1>Reset Password</h1>
        <p>Enter a new password for your account.</p>

        <form action="/reset-password/{{token}}" method="post">
            <div class="mb-3">
                <label for="password" class="form-label">New password:</label>
                <input type="password" class="form-control italic-placeholder" name="password" id="password" placeholder="At least 6 characters" required>
            </div>
            <div class="mb-4">
                <label for="passwordVerify" class="form-label">Confirm new password:</label>
                <input type="password" class="form-control italic-placeholder" name="passwordVerify" id="passwordVerify" placeholder="Repeat your new password" required>
            </div>
            <button type="submit" class="btn btn-form-primary">Update Password</button>
        </form>
    </div>
</div>
