<link rel="stylesheet" href="/css/bill-detail.css">
<div class="bill-detail-page">

    <div class="bill-hero">
        <div class="container">
            <h1 class="bill-hero-title">Forgot Password</h1>
            <p style="color: rgba(255,255,255,0.75); font-size: 1rem; margin: 0;">We'll send a reset link to your email</p>
        </div>
    </div>

    <div class="container bill-detail-body">
        <div class="bill-detail-card auth-card">
            {{> flash-messages}}
            <h4 class="bill-detail-card-title">Reset Your Password</h4>

            <form action="/forgot-password" method="post">
                <div class="mb-4">
                    <label for="email" class="update-label">Email address:</label>
                    <input type="email" class="update-input" name="email" id="email" placeholder="you@example.com">
                </div>
                <button type="submit" class="btn-make-payment">Send Reset Link</button>
            </form>

            <div class="auth-links">
                <a href="/login" class="auth-link">Back to Log In</a>
            </div>
        </div>
    </div>

</div>
