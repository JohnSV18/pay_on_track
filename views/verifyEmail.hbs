<div class="page-container">
    <div class="form-box">
        {{> flash-messages}}
        <h1>Check your email</h1>
        <p>We sent a 6-digit verification code to your email address. Enter it below to activate your account.</p>

        <form action="/verify-email" method="post">
            <div class="mb-4">
                <label for="code" class="form-label">Verification code:</label>
                <input
                    type="text"
                    class="form-control italic-placeholder"
                    name="code"
                    id="code"
                    placeholder="123456"
                    maxlength="6"
                    inputmode="numeric"
                    autocomplete="one-time-code"
                    required>
            </div>
            <button type="submit" class="btn btn-form-primary">Verify Email</button>
        </form>

        <p class="mt-3">Didn't receive the code? <a href="/signup" class="card-link">Sign up again</a></p>
    </div>
</div>
