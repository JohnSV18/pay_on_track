<div class="page-container">
    <div class="form-box">
        {{> flash-messages}}
        <h1>Welcome Back</h1>
        
        <form action="/login" method="post" id="loginform">
            <div class="mb-3">
                <label for="email" class="form-label">Email address:</label>
                <input type="email" class="form-control italic-placeholder" name="email" id="email" placeholder="you@example.com">
            </div>

            <div class="mb-4">
                <label for="password" class="form-label">Enter your password:</label>
                <input type="password" class="form-control italic-placeholder" name="password" id="password" placeholder="'Password'">
            </div>

            <button type="submit" class="btn btn-form-primary">Log In</button>
        </form>
        <a href="/forgot-password" class="card-link d-block">Forgot your password?</a>
        <a href="/signup" class="card-link">Don't have an account yet? Sign Up</a>
    </div>
</div>
