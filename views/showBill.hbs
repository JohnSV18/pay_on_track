<div class="container">
    <div class="card-header-custom">
            {{data.title}}
    </div>

    <div class="row">
        <div class="detail-card col-lg-6 col-12">
            <div>
                <h4 class="card-title"> Bill Details</h4>
                <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted fw-medium">Bill Type:</span>
                        <span class="fw-bold">{{data.type}}</span>
                </div>
                 <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted fw-medium">Category:</span>
                        <span class="fw-bold">Entertainment</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted fw-medium">Bill Description:</span>
                        <span class="fw-bold">{{data.description}}</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted fw-medium">Due by:</span>
                        <span class="fw-bold">{{data.dueDate}}</span>
                </div>
                <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted fw-medium">Current Balance:</span>
                        <span class="fw-bold">${{data.currentBalance}}</span>
                </div>
                <a href="#" class="card-link">Update Current Balance?</a>
                <a href="/bills/update/{{data._id}}" class="card-link">Update with a payment</a>
            </div>
        </div>


        <div class="detail-card col-lg-6 col-12">
            <div>
                <h5 class="card-title"> Payment History</h5>
                <h6 class="card-subtitle mb-2 text-muted">Card subtitle</h6>
                <p class="card-text">Some quick example text to build on the card title and make up the bulk of the card's content.</p>
                <a href="#" class="card-link">Card link</a>
                <a href="#" class="card-link">Another link</a>
            </div>
        </div>
    </div>
</div>